# Modelo das variáveis de build do front. Copie para `.env.local`.
# São lidas em tempo de build (veja `define` no vite.config.ts).

# URL da API. Em desenvolvimento o padrão já é http://localhost:5099.
VITE_API_URL=http://localhost:5099

# Domínio público, usado nas tags canonical e Open Graph.
# No Vercel é preenchido automaticamente.
VITE_SITE_URL=http://localhost:5173

# Client id do Google Identity Services. Vazio esconde o botão "Entrar com Google".
# Precisa ser o mesmo valor de `Google__ClientId` na API.
VITE_GOOGLE_CLIENT_ID=

# ---------------------------------------------------------------------------
# API (`apps/api`). O compose lê este mesmo arquivo. Use `__` para aninhar.
# Em produção estes valores vão como segredos do ambiente, nunca no repositório.
# ---------------------------------------------------------------------------

# String de conexão do Postgres. No compose o host é `db`; fora dele, `localhost`.
ConnectionStrings__Default=Host=localhost;Port=5432;Database=dialo_game;Username=dialo;Password=dialo_dev

# Chave de assinatura do JWT. Mínimo de 32 caracteres — abaixo disso a API não sobe.
# Gere com: openssl rand -base64 48
Jwt__SigningKey=

# Client id do Google validado no servidor. Deve ser igual a VITE_GOOGLE_CLIENT_ID.
Google__ClientId=

# Origens autorizadas (lista fechada, sem barra final e sem caminho). Para mais de
# uma, incremente o índice: Cors__AllowedOrigins__1, __2, ...
# `*` é recusado no boot: com AllowCredentials o curinga lançaria em runtime.
Cors__AllowedOrigins__0=http://localhost:5173

# Cookie de refresh. `true` (padrão) emite `SameSite=None; Secure` e exige HTTPS.
# Só use `false` em HTTP local, senão o navegador descarta o cookie.
Auth__RefreshCookieSecure=false

# Migrations no boot. Em produção mantenha `false` e rode `dotnet ef database
# update` no pipeline — duas réplicas subindo juntas aplicariam a mesma migration.
ApplyMigrationsOnStartup=false

# Token exigido no scrape de /metrics. Sem ele o endpoint não é publicado.
Metrics__Token=
