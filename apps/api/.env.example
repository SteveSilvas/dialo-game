# Copie para .env e ajuste. Nunca comite o .env real.

# Banco
POSTGRES_DB=dialo_game
POSTGRES_USER=dialo
POSTGRES_PASSWORD=troque-esta-senha

# String de conexão usada pela API (o host "db" é o serviço do compose)
ConnectionStrings__Default=Host=db;Port=5432;Database=dialo_game;Username=dialo;Password=troque-esta-senha

# Chave de assinatura do JWT: mínimo 32 caracteres.
# Gere com: openssl rand -base64 48
Jwt__SigningKey=

# Client ID do Google OAuth (opcional; sem ele o login Google fica desativado)
Google__ClientId=

# Origens liberadas no CORS, separadas por vírgula
Cors__AllowedOrigins__0=http://localhost:5173

# Aplica migrations e seed ao subir. Deixe false em produção e rode
# `dotnet ef database update` no pipeline.
ApplyMigrationsOnStartup=false

# Cookie de refresh exige HTTPS. Só deixe false em desenvolvimento local.
Auth__RefreshCookieSecure=true

# Log estruturado em JSON no console (uma linha por requisição, com request id).
# false desliga o sink e o resumo; útil em teste que não mede log.
Logging__Structured__Enabled=true

# Nível mínimo do Serilog. É esta seção que vale: o Serilog substitui o provider
# padrão, então Logging__LogLevel__* não tem efeito.
Serilog__MinimumLevel__Default=Information
