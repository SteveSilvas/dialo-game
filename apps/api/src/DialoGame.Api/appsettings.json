{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": ""
  },
  "Jwt": {
    "Issuer": "dialo-game",
    "Audience": "dialo-game-web",
    "SigningKey": "",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "Google": {
    "ClientId": ""
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "ApplyMigrationsOnStartup": false,
  "Auth": {
    "RefreshCookieSecure": true,
    "RefreshCookiePath": "/auth"
  },
  "RateLimiting": {
    "Enabled": true,
    "LoginPermitLimit": 10,
    "LoginWindowMinutes": 15,
    "RegisterPermitLimit": 5,
    "RegisterWindowMinutes": 60
  }
}
